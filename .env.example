# Election Management Platform — Environment Configuration
# Copy to .env and update values before running.

# Application
APP_NAME=Election Management Platform
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Website Database (MySQL — single source of truth)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=election_db
DATABASE_USER=root
DATABASE_PASSWORD=

# JWT Authentication
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY=60
JWT_REFRESH_EXPIRY_DAYS=7
NODE_JWT_EXPIRY_HOURS=24

# Backend Paths
UPLOAD_FOLDER=backend/uploads
REPORT_FOLDER=backend/generated_reports
BACKUP_FOLDER=backend/backups
LOG_FOLDER=backend/logs

# WebSocket
WEBSOCKET_TIMEOUT=30

# Website (NiceGUI)
BACKEND_URL=http://localhost:8000
API_PREFIX=/api/v1
WEBSITE_HOST=0.0.0.0
WEBSITE_PORT=8080
WEBSITE_RELOAD=false

# Desktop Voting Node
WEBSITE_URL=http://localhost:8000
NODE_ID=
NODE_SECRET=
DESKTOP_CONFIG_DIR=desktop/data/config
DESKTOP_LOG_DIR=desktop/logs

# Desktop Local Database (independent from website)
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3306
LOCAL_DB_NAME=local_election
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=
