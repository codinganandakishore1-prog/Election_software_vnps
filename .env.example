# Election Management Platform — Environment Configuration
# Copy to .env and update values before running.
#
# Production (Render): prefer render.yaml env vars; use this file for local/dev only.

# Application
APP_NAME=Election Management Platform
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
# Local/dev: write rotating log files. Production/Render: leave false (stdout only).
LOG_TO_FILE=true

# Website Database (MySQL — single source of truth in production)
# Prefer individual fields, or set DATABASE_URL=mysql+pymysql://user:pass@host:3306/db
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=election_db
DATABASE_USER=root
DATABASE_PASSWORD=
# Local/dev without MySQL: use SQLite and auto-create schema + demo users
# (admin/admin123, superadmin/super123, viewer/viewer123)
# DATABASE_URL=sqlite+pysqlite:///./data/election_dev.db
# BOOTSTRAP_DATABASE=true
# DATABASE_URL=

# JWT Authentication (required: >=32 chars when ENVIRONMENT=production)
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY=720
JWT_REFRESH_EXPIRY_DAYS=30
NODE_JWT_EXPIRY_HOURS=72

# Backend Paths
# Local defaults are relative; Docker/Render use absolute /data/* mounts.
UPLOAD_FOLDER=backend/uploads
REPORT_FOLDER=backend/generated_reports
BACKUP_FOLDER=backend/backups
CONFIG_PACKAGE_FOLDER=backend/config_packages
LOG_FOLDER=backend/logs

# CORS — comma-separated origins. Required (no *) when ENVIRONMENT=production.
# Example: CORS_ORIGINS=https://election-website.onrender.com,http://localhost:8080
CORS_ORIGINS=*

# Rate limiting (per authenticated user/token, or per IP for login)
# Set RATE_LIMIT_REQUESTS=0 to disable entirely.
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_REQUESTS=60

# WebSocket
WEBSOCKET_TIMEOUT=30

# Analytics (optional — enables turnout percentage on analytics dashboards)
# ANALYTICS_ELIGIBLE_VOTERS=2000

# Website (NiceGUI)
# Server-side API base URL. On Render private network use BACKEND_HOST=election-api:10000
BACKEND_URL=http://localhost:8000
# BACKEND_HOST=
API_PREFIX=/api/v1
WEBSITE_HOST=0.0.0.0
WEBSITE_PORT=8080
# Platform PORT (Render/Docker) overrides WEBSITE_PORT when set.
# PORT=8080
WEBSITE_RELOAD=false
WEBSITE_STORAGE_SECRET=change-me-in-production-use-a-long-random-string

# Desktop Voting Node
WEBSITE_URL=http://localhost:8000
NODE_ID=
NODE_SECRET=
DESKTOP_CONFIG_DIR=desktop/data/config
DESKTOP_LOG_DIR=desktop/logs

# Desktop Local Database (independent from website)
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=3306
LOCAL_DB_NAME=local_election
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=

# Desktop Synchronization
SYNC_UPLOADS_ENABLED=true
SYNC_BATCH_SIZE=20
SYNC_POLL_INTERVAL_MS=200

# Desktop Heartbeat
HEARTBEAT_ENABLED=true
HEARTBEAT_INTERVAL_SECONDS=10
